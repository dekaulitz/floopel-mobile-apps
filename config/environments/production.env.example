# No production endpoint is assumed. Set the approved HTTPS origin in CI/local environment.
FLOOPEL_PRODUCTION_API_ORIGIN=
FLOOPEL_PRODUCTION_GOOGLE_SERVER_CLIENT_ID=
FLOOPEL_PRODUCTION_PLAY_CLOUD_PROJECT_NUMBER=0

# Prepared for pending integrations. GOOGLE_SERVICES_JSON is Android client configuration,
# never a Firebase Admin service-account file or private key.
FLOOPEL_PRODUCTION_GOOGLE_MAPS_API_KEY=
FLOOPEL_PRODUCTION_GOOGLE_SERVICES_JSON=
FLOOPEL_PRODUCTION_PUBLIC_WEB_ORIGIN=

# Reserved iOS host inputs; no Xcode binding/provider integration yet.
FLOOPEL_PRODUCTION_IOS_GOOGLE_CLIENT_ID=
FLOOPEL_PRODUCTION_IOS_GOOGLE_SERVICE_INFO_PLIST=
FLOOPEL_PRODUCTION_IOS_GOOGLE_MAPS_API_KEY=

# Release signing is environment-only and never copied to BuildConfig/resources.
FLOOPEL_TRAVELER_PRODUCTION_KEYSTORE_FILE=
FLOOPEL_TRAVELER_PRODUCTION_KEYSTORE_PASSWORD=
FLOOPEL_TRAVELER_PRODUCTION_KEY_ALIAS=
FLOOPEL_TRAVELER_PRODUCTION_KEY_PASSWORD=
FLOOPEL_PARTNER_PRODUCTION_KEYSTORE_FILE=
FLOOPEL_PARTNER_PRODUCTION_KEYSTORE_PASSWORD=
FLOOPEL_PARTNER_PRODUCTION_KEY_ALIAS=
FLOOPEL_PARTNER_PRODUCTION_KEY_PASSWORD=

FLOOPEL_TRAVELER_VERSION_CODE=1
FLOOPEL_TRAVELER_VERSION_NAME=0.1.0
FLOOPEL_PARTNER_VERSION_CODE=1
FLOOPEL_PARTNER_VERSION_NAME=0.1.0
