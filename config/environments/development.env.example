# Client build configuration. Export these variables before invoking Gradle.
FLOOPEL_DEVELOPMENT_API_ORIGIN=http://10.0.2.2:8080
FLOOPEL_DEVELOPMENT_GOOGLE_SERVER_CLIENT_ID=
FLOOPEL_DEVELOPMENT_PLAY_CLOUD_PROJECT_NUMBER=0

# Prepared for pending integrations; these do not enable an SDK or delivery by themselves.
FLOOPEL_DEVELOPMENT_GOOGLE_MAPS_API_KEY=
FLOOPEL_DEVELOPMENT_GOOGLE_SERVICES_JSON=
FLOOPEL_DEVELOPMENT_PUBLIC_WEB_ORIGIN=

# Reserved iOS host inputs; no Xcode binding/provider integration yet.
FLOOPEL_DEVELOPMENT_IOS_GOOGLE_CLIENT_ID=
FLOOPEL_DEVELOPMENT_IOS_GOOGLE_SERVICE_INFO_PLIST=
FLOOPEL_DEVELOPMENT_IOS_GOOGLE_MAPS_API_KEY=

# Optional CI version inputs; Android debug signing uses the local debug keystore.
FLOOPEL_TRAVELER_VERSION_CODE=1
FLOOPEL_TRAVELER_VERSION_NAME=0.1.0
FLOOPEL_PARTNER_VERSION_CODE=1
FLOOPEL_PARTNER_VERSION_NAME=0.1.0
