package main

import (
	"context"
	"encoding/json"
	"errors"
	"github.com/floopel/backend/internal/adapter/repository/postgres"
	pgmedia "github.com/floopel/backend/internal/modules/media/adapter/repository/postgres/media"
	mediauc "github.com/floopel/backend/internal/modules/media/usecase/media"
	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	"time"
)

// All transitions use the canonical repository; only claim selection is narrowed to one fixture cover.
type scopedMediaJobs struct {
	*pgmedia.Repository
	pool               *pgxpool.Pool
	mediaID, profileID string
}

// Never run global lease recovery from a fixture command.
func (r *scopedMediaJobs) RecoverExpiredProcessing(context.Context, time.Time, time.Time, int) ([]mediauc.ProcessingJob, error) {
	return nil, errors.New("bulk recovery is excluded from this fixture command")
}

func (r *scopedMediaJobs) ClaimProcessing(ctx context.Context, workerID string, now, until time.Time) (mediauc.ProcessingJob, bool, error) {
	if !postgres.InTransaction(ctx) {
		return mediauc.ProcessingJob{}, false, errors.New("claim requires transaction")
	}
	const query = `WITH candidate AS (
 SELECT j.id FROM media_processing_job j
 WHERE j.media_asset_id=$4 AND j.status IN ('queued','retry_wait')
 AND j.available_at <= $1 AND j.attempt_count < j.max_attempts
 AND EXISTS(SELECT 1 FROM itinerary i WHERE i.cover_media_id=j.media_asset_id AND i.owner_profile_id=$5 AND i.source='user_created')
 ORDER BY j.available_at,j.created_at FOR UPDATE SKIP LOCKED LIMIT 1
 ) UPDATE media_processing_job j SET status='processing',attempt_count=j.attempt_count+1,
 lease_owner=$2,lease_expires_at=$3,fencing_token=j.fencing_token+1,
 started_at=COALESCE(j.started_at,$1),last_error_code=NULL,updated_at=$1
 FROM candidate WHERE j.id=candidate.id
 RETURNING j.id,j.media_asset_id,j.processor_version,j.variant_spec_hash,j.requested_variants,
 j.status,j.attempt_count,j.max_attempts,j.available_at,j.lease_owner,j.lease_expires_at,j.fencing_token,j.correlation_id`
	var job mediauc.ProcessingJob
	var variants []byte
	q := postgres.Querier(ctx, r.pool)
	err := q.QueryRow(ctx, query, now, workerID, until, r.mediaID, r.profileID).Scan(&job.ID, &job.MediaAssetID, &job.ProcessorVersion, &job.VariantSpecHash, &variants,
		&job.Status, &job.AttemptCount, &job.MaxAttempts, &job.AvailableAt, &job.LeaseOwner, &job.LeaseExpiresAt, &job.FencingToken, &job.CorrelationID)
	if errors.Is(err, pgx.ErrNoRows) {
		return mediauc.ProcessingJob{}, false, nil
	}
	if err != nil {
		return mediauc.ProcessingJob{}, false, err
	}
	if err = json.Unmarshal(variants, &job.RequestedVariants); err != nil {
		return mediauc.ProcessingJob{}, false, err
	}
	_, err = q.Exec(ctx, `UPDATE media_asset SET processing_status='processing',processing_version=$2,processing_error_code=NULL
 WHERE id=$1 AND processing_status IN ('uploaded','processing','failed')`, job.MediaAssetID, job.ProcessorVersion)
	return job, err == nil, err
}
