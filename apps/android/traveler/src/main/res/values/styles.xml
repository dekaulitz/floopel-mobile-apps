<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Floopel" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/floopel_startup_background</item>
    </style>
    <style name="Base.Theme.Floopel.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/floopel_startup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/floopel_startup_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Floopel</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/floopel_startup_background</item>
        <item name="android:navigationBarColor">@color/floopel_startup_background</item>
    </style>
    <style name="Theme.Floopel.Starting" parent="Base.Theme.Floopel.Starting" />
</resources>
